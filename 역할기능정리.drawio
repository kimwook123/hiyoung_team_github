        <mxCell id="09wRK7Cv7sNQ-6NyP0p5-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=22;fontStyle=1;align=center;" value="서버-클라이언트-뷰어 역할 정리" vertex="1">
